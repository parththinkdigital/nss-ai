# NVIDIA NIM API Configuration
# Get your API key from NVIDIA NIM catalog: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Model name (Default: openai/gpt-oss-20b)
NVIDIA_MODEL=openai/gpt-oss-20b

# NVIDIA NIM Base URL (Default: https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Port configuration (Railway will inject PORT automatically)
PORT=3000
